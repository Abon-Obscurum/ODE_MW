<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="ode05.cde.fx.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefWidth="200.0">
         <Label text="Zahl 1"/>
         <TextField fx:id="tfNum1"/>
      </HBox>
      <HBox prefWidth="200.0">
         <Label text="Zahl 2"/>
         <TextField fx:id="tfNum2"/>
      </HBox>
      <HBox alignment="CENTER" prefWidth="200.0" spacing="20.0">
         <Button fx:id="btnPlus" onAction="#onPlusClick" mnemonicParsing="false" text="+"/>
         <Button fx:id="btnMinus" mnemonicParsing="false" text="-"/>
         <Button mnemonicParsing="false" text="*"/>
         <Button mnemonicParsing="false" text="/"/>
      </HBox>
      <Label fx:id="lbResult" text="Ergebnis" />
   </children>
</VBox>
