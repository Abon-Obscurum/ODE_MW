<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ode05.chat.RegisterController">
   <children>
      <Label text="Register" />
      <TextField fx:id="userName" maxWidth="400.0" promptText="Username" />
      <PasswordField fx:id="password" maxWidth="400.0" promptText="Password" />
      <Button mnemonicParsing="false" onAction="#register" text="Register" />
      <Label fx:id="message" />
      <Hyperlink onAction="#toLogin" text="Already have an account? Log in" />
   </children>
</VBox>
